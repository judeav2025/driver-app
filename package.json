{
  "name": "avanticon-driver",
  "version": "0.1.0",
  "private": true,
  "description": "Phone-tilt driving game: scan a QR, get a car, race on the big screen.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "share": "node scripts/share.js",
    "test": "node --test \"test/*.test.js\"",
    "cf:dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "e2e": "playwright test --project=local",
    "e2e:live": "playwright test --project=live",
    "predeploy": "npm test && npm run e2e",
    "postdeploy": "npm run e2e:live"
  },
  "dependencies": {
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "wrangler": "^4.151.3"
  }
}
